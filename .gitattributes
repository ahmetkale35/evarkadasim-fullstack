# Normalize line endings to LF on commit
* text=auto eol=lf

# Force LF for source files
*.cs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf

# Binary files — no line ending conversion
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
